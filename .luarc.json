{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.1",
    "path": [
      "?.lua",
      "?/init.lua"
    ]
  },
  "workspace": {
    "library": [
      ".types/wow-api/Annotations"
    ],
    "ignoreDir": [
      "libs",
      ".types",
      "tests"
    ],
    "checkThirdParty": "Disable"
  },
  "diagnostics": {
    "libraryFiles": "Disable",
    "ignoredFiles": "Disable",
    "globals": [
      "SLASH_BagBrother1",
      "SLASH_BagBrother2"
    ]
  }
}